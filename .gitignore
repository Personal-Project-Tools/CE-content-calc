# Python & Virtual Environment
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Credentials, secrets & internal mapping configs
.env
.env.*
!.env.example
config/service.json
config/*service*.json
config/*credentials*.json
config/*secret*.json
!config/*.example.json
config/sheet.yaml
config/sheet_content.yaml
config/sheet_config.yaml
config/sheet*.yaml
!config/*.example.yaml
config/seller_list.xlsx
extension/config
extension/config/

# Runtime downloaded raw files & generated Excel outputs
data/raw_file/*
!data/raw_file/.gitkeep
!data/raw_file/Daily/
data/raw_file/Daily/*
!data/raw_file/Daily/.gitkeep
!data/raw_file/Monthly/
data/raw_file/Monthly/*
!data/raw_file/Monthly/.gitkeep
data/reports/*
!data/reports/.gitkeep

# Temporary, Office lock, and local OS files
~$*.xlsx
Note.txt
temp/
.DS_Store
Thumbs.db
logs/
